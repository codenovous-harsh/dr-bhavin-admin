# ─────────────────────────────────────────────────────────────────────────────
# dr-bhavin-admin (CMS) — environment variables
#
# Copy to `.env.local` for dev and set the same keys in your host for prod.
# ─────────────────────────────────────────────────────────────────────────────

# Backend API base URL, including the /api path. The admin talks to
# dr-bhavin-garara-backend here (auth, blogs, patients, enquiries, contacts).
# Note: the local backend runs on port 5001.
# Fallback: http://localhost:5000/api
NEXT_PUBLIC_API_URL="http://localhost:5001/api"

# ── Error monitoring (optional) ──────────────────────────────────────────────
# Sentry DSN. Leave blank to disable. Set NEXT_PUBLIC_SENTRY_DISABLED=true to
# force-disable even when a DSN is present.
NEXT_PUBLIC_SENTRY_DSN=""
NEXT_PUBLIC_SENTRY_DISABLED="true"
